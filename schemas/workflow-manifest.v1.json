{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaia.dev/schemas/workflow-manifest.v1.json",
  "title": "GAIA Universal Workflow Manifest v1 (Stage A local prototype)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "controls"
  ],
  "properties": {
    "apiVersion": {
      "const": "gaia.dev/v1"
    },
    "kind": {
      "const": "WorkflowManifest"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "owner",
        "domain"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WF-[A-Z0-9]+-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "scope",
        "goal",
        "inputs",
        "outputs"
      ],
      "properties": {
        "scope": {
          "type": "object",
          "required": [
            "exempt"
          ],
          "properties": {
            "exempt": {
              "type": "boolean"
            },
            "justification": {
              "type": [
                "string",
                "null"
              ]
            },
            "approver": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "goal": {
          "type": "object",
          "required": [
            "statement",
            "acceptance_tests",
            "non_goals"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "acceptance_tests": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "statement",
                  "falsifiable"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "falsifiable": {
                    "const": true
                  }
                },
                "additionalProperties": true
              }
            },
            "non_goals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      },
      "additionalProperties": true
    },
    "controls": {
      "type": "object",
      "required": [
        "provenance",
        "versioning",
        "testing",
        "security",
        "privacy",
        "human_approval",
        "observability",
        "resilience",
        "learning"
      ],
      "properties": {
        "provenance": {
          "type": "object",
          "required": [
            "applicable"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "versioning": {
          "type": "object",
          "required": [
            "applicable"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "testing": {
          "type": "object",
          "required": [
            "applicable"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "security": {
          "type": "object",
          "required": [
            "applicable"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "privacy": {
          "type": "object",
          "required": [
            "applicable"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "human_approval": {
          "type": "object",
          "required": [
            "applicable"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "observability": {
          "type": "object",
          "required": [
            "applicable"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "resilience": {
          "type": "object",
          "required": [
            "applicable"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "learning": {
          "type": "object",
          "required": [
            "applicable"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string"
        },
        "last_validated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "validators": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "schema_uri",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_uri": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
