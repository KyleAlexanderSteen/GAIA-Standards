{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaia.dev/schemas/gaian-registry-record.v1.json",
  "title": "GAIAN Registry Record",
  "description": "Identity and consent record for a human-linked GAIAN. A record never grants authority over the human.",
  "type": "object",
  "required": ["schema_version", "gaian_id", "human_principal_ref", "consent", "privacy_boundary", "created_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "gaian_id": {
      "type": "string",
      "pattern": "^GAIAN-[A-Z0-9]{8,}$",
      "description": "Stable identifier for the GAIAN. Does not grant authority."
    },
    "human_principal_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to the human principal. Must not be inferred."
    },
    "consent": {
      "type": "object",
      "required": ["granted", "granted_at", "scope", "withdrawable"],
      "additionalProperties": false,
      "properties": {
        "granted": { "type": "boolean" },
        "granted_at": { "type": "string", "format": "date-time" },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "withdrawable": { "const": true },
        "withdrawn_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "privacy_boundary": {
      "type": "object",
      "required": ["readable_by", "fields_exposed"],
      "additionalProperties": false,
      "properties": {
        "readable_by": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fields_exposed": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "at", "by"],
        "properties": {
          "action": { "enum": ["create", "read", "update", "export", "delete", "withdraw_consent"] },
          "at": { "type": "string", "format": "date-time" },
          "by": { "type": "string", "minLength": 1 }
        }
      }
    },
    "grants_authority": {
      "const": false,
      "description": "Must always be false. A GAIAN record never grants authority over the human."
    }
  }
}
